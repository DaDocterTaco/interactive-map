rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Preserve the project's existing test-mode policy outside Campus Chat.
    match /{collection}/{document}/{rest=**} {
      allow read, write: if request.time < timestamp.date(2026, 10, 25)
        && !(collection == 'chats' && document == 'campus-public');
    }

    match /chats/campus-public/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['senderId', 'name', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['senderId', 'name', 'text', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.name.matches('.*\\S.*')
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.text.matches('.*\\S.*')
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      // Requested demo behavior: any signed-in chat participant can clear it.
      allow delete: if request.auth != null;
    }
  }
}
