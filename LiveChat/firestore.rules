rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function group(id) { return get(/databases/$(database)/documents/chats/$(id)).data; }
    function active(data) { return !('deletedAt' in data); }
    function member(id) { return signedIn() && exists(/databases/$(database)/documents/chats/$(id)/members/$(request.auth.uid)); }
    function directParticipant(data) { return signedIn() && request.auth.uid in data.get('participantIds', []); }
    function visibleChat(data) { return data.visibility in ['public', 'private'] || directParticipant(data); }
    function moderator() {
      let role = /databases/$(database)/documents/users/$(request.auth.uid)/roles/moderator;
      return signedIn() && exists(role) && get(role).data.enabled == true;
    }
    function canModerate(id) {
      return moderator() && (id == 'Campus Chat'
        || (group(id).visibility in ['public', 'private'] && member(id) && active(group(id))));
    }
    function validMessage() {
      let data = request.resource.data;
      return signedIn()
        && data.keys().hasAll(['senderId', 'name', 'text', 'createdAt'])
        && data.keys().hasOnly(['senderId', 'name', 'text', 'createdAt'])
        && data.senderId == request.auth.uid
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.name.matches('.*\\S.*')
        && data.text is string && data.text.size() > 0 && data.text.size() <= 2000
        && data.text.matches('.*\\S.*')
        && data.createdAt == request.time;
    }
    // Keep the existing project's policy for unrelated data only.
    match /{collection}/{document}/{rest=**} {
      allow read, write: if request.time < timestamp.date(2026, 10, 25)
        && !(collection in ['chats', 'chatGroups', 'chatGroupSecrets', 'chatPreferences', 'forums', 'users', 'pulse']);
    }

    match /forums/{postId} {
      function validText(value, maximum) {
        // Match across newlines, while rejecting whitespace-only posts and replies.
        return value is string && value.size() > 0 && value.size() <= maximum
          && value.matches('[\\s\\S]*\\S[\\s\\S]*');
      }
      function validAuthor(data) {
        return data.authorId == request.auth.uid && validText(data.name, 40);
      }
      function validLocation(location) {
        return location is map && location.keys().hasOnly(['label', 'latitude', 'longitude'])
          && validText(location.label, 120)
          && location.latitude is number && location.latitude >= -90 && location.latitude <= 90
          && location.longitude is number && location.longitude >= -180 && location.longitude <= 180;
      }
      function warningOpen(data) {
        return data.category == 'Alert' && !('resolution' in data) && !('rejection' in data)
          && request.time < (('verification' in data) ? data.verification.approvedAt : data.createdAt) + duration.value(24, 'h');
      }
      function authorizedVerifier() {
        let role = /databases/$(database)/documents/users/$(request.auth.uid)/roles/verifier;
        return exists(role) && get(role).data.enabled == true;
      }
      function confirmationActivity() {
        let after = request.resource.data;
        let path = /databases/$(database)/documents/forums/$(postId)/confirmations/$(request.auth.uid);
        return warningOpen(resource.data) && resource.data.authorId != request.auth.uid
          && after.diff(resource.data).affectedKeys().hasOnly(['confirmationCount', 'lastConfirmationBy'])
          && after.lastConfirmationBy == request.auth.uid && after.confirmationCount is int && after.confirmationCount >= 0
          && ((!exists(path) && existsAfter(path) && after.confirmationCount == resource.data.confirmationCount + 1)
            || (exists(path) && !existsAfter(path) && after.confirmationCount == resource.data.confirmationCount - 1));
      }
      function validPost() {
        let data = request.resource.data;
        return data.keys().hasAll(['authorId', 'name', 'title', 'body', 'category', 'createdAt', 'lastActivityAt', 'replyCount', 'lastReplyId'])
          && ((data.category != 'Alert' && data.keys().hasOnly(['authorId', 'name', 'title', 'body', 'category', 'createdAt', 'lastActivityAt', 'replyCount', 'lastReplyId', 'topic'])
              && (!('topic' in data) || data.topic in ['Classes', 'Study spaces', 'Campus life', 'Parking & transit', 'Housing', 'Other']))
            || (data.category == 'Alert' && data.keys().hasOnly(['authorId', 'name', 'title', 'body', 'category', 'createdAt', 'lastActivityAt', 'replyCount', 'lastReplyId', 'location', 'confirmationCount', 'lastConfirmationBy', 'issueType'])
              && (!('issueType' in data) || data.issueType in ['Flooding', 'Blocked path', 'Facility outage', 'Accessibility', 'Other'])
              && validLocation(data.location) && data.confirmationCount == 0 && data.lastConfirmationBy == ''))
          && validAuthor(data) && validText(data.title, 140) && validText(data.body, 5000)
          && data.category in ['Question', 'Comment', 'Concern', 'Alert', 'Other']
          && data.createdAt == request.time && data.lastActivityAt == request.time
          && data.replyCount == 0 && data.lastReplyId == '';
      }
      function verifierApproval() {
        let approval = request.resource.data.verification;
        return warningOpen(resource.data) && resource.data.authorId != request.auth.uid
          && !('verification' in resource.data)
          && (!('detailRequest' in resource.data) || 'clarification' in resource.data)
          && authorizedVerifier()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verification'])
          && approval is map && approval.keys().hasOnly(['status', 'verifierId', 'verifierName', 'approvedAt'])
          && approval.status == 'approved' && approval.verifierId == request.auth.uid
          && validText(approval.verifierName, 40) && approval.approvedAt == request.time;
      }
      function resolveWarning() {
        let resolution = request.resource.data.resolution;
        return warningOpen(resource.data)
          && (resource.data.authorId == request.auth.uid || authorizedVerifier())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolution'])
          && resolution is map && resolution.keys().hasOnly(['status', 'resolvedBy', 'resolvedName', 'resolvedAt', 'note'])
          && resolution.status == 'resolved' && resolution.resolvedBy == request.auth.uid
          && validText(resolution.resolvedName, 40) && resolution.resolvedAt == request.time
          && resolution.note is string && resolution.note.size() <= 500;
      }
      function reviewDecision(field) {
        let decision = request.resource.data[field];
        return warningOpen(resource.data) && authorizedVerifier() && resource.data.authorId != request.auth.uid
          && !(field in resource.data)
          && (field == 'rejection' || !('verification' in resource.data))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
          && decision.keys().hasAll(['by', 'name', 'at', 'reason'])
          && decision.keys().hasOnly(['by', 'name', 'at', 'reason'])
          && decision.by == request.auth.uid && validText(decision.name, 40)
          && decision.at == request.time && validText(decision.reason, 500);
      }
      function clarifyWarning() {
        let response = request.resource.data.clarification;
        return warningOpen(resource.data) && resource.data.authorId == request.auth.uid
          && 'detailRequest' in resource.data && !('clarification' in resource.data) && !('verification' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clarification'])
          && response.keys().hasAll(['by', 'at', 'body']) && response.keys().hasOnly(['by', 'at', 'body'])
          && response.by == request.auth.uid && response.at == request.time && validText(response.body, 2000);
      }
      function replyActivity() {
        let data = request.resource.data;
        let replyPath = /databases/$(database)/documents/forums/$(postId)/replies/$(data.lastReplyId);
        return data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'lastReplyId', 'lastActivityAt'])
          && data.replyCount is int && data.replyCount == resource.data.replyCount + 1
          && data.lastReplyId is string && data.lastReplyId.size() > 0
          && data.lastActivityAt == request.time && !exists(replyPath)
          && getAfter(replyPath).data.authorId == request.auth.uid
          && getAfter(replyPath).data.createdAt == request.time;
      }
      function matchingAnswer(data) {
        let path = /databases/$(database)/documents/forums/$(postId)/replies/$(data.acceptedReplyId);
        let answer = data.acceptedAnswer;
        return exists(path) && answer is map
          && answer.keys().hasAll(['replyId', 'name', 'body', 'authorId'])
          && answer.keys().hasOnly(['replyId', 'name', 'body', 'authorId'])
          && answer.replyId == data.acceptedReplyId
          && answer.name == get(path).data.name && answer.body == get(path).data.body
          && answer.authorId == get(path).data.authorId;
      }
      function acceptedAnswer() {
        let data = request.resource.data;
        return resource.data.category == 'Question' && resource.data.authorId == request.auth.uid
          && data.diff(resource.data).affectedKeys().hasOnly(['acceptedReplyId', 'acceptedAnswer'])
          && data.keys().hasAll(['acceptedReplyId', 'acceptedAnswer'])
          && data.acceptedReplyId is string
          && ((data.acceptedReplyId == '' && data.acceptedAnswer == null)
            || (data.acceptedReplyId.matches('^[A-Za-z0-9_-]{1,128}$') && matchingAnswer(data)));
      }
      allow read: if signedIn();
      allow create: if signedIn() && validPost();
      allow update: if signedIn() && (replyActivity() || confirmationActivity() || verifierApproval() || resolveWarning() || acceptedAnswer() || reviewDecision('rejection') || reviewDecision('detailRequest') || clarifyWarning());
      allow delete: if false;

      match /confirmations/{uid} {
        function validChange(delta) {
          let parent = /databases/$(database)/documents/forums/$(postId);
          return signedIn() && request.auth.uid == uid && warningOpen(get(parent).data)
            && get(parent).data.authorId != uid
            && getAfter(parent).data.confirmationCount == get(parent).data.confirmationCount + delta
            && getAfter(parent).data.lastConfirmationBy == uid;
        }
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, update: if false;
        allow create: if validChange(1)
          && request.resource.data.keys().hasOnly(['userId', 'name', 'createdAt'])
          && request.resource.data.userId == uid && validText(request.resource.data.name, 40)
          && request.resource.data.createdAt == request.time;
        allow delete: if validChange(-1);
      }
      match /replies/{replyId} {
        function validReply() {
          let data = request.resource.data;
          let parent = /databases/$(database)/documents/forums/$(postId);
          return data.keys().hasAll(['authorId', 'name', 'body', 'createdAt'])
            && data.keys().hasOnly(['authorId', 'name', 'body', 'createdAt', 'parentId'])
            && validAuthor(data) && validText(data.body, 2000) && data.createdAt == request.time
            && (!('parentId' in data) || (data.parentId is string
              && data.parentId.matches('^[A-Za-z0-9_-]{1,128}$') && data.parentId != replyId
              && exists(/databases/$(database)/documents/forums/$(postId)/replies/$(data.parentId))))
            && exists(parent)
            && getAfter(parent).data.lastReplyId == replyId
            && getAfter(parent).data.replyCount == get(parent).data.replyCount + 1
            && getAfter(parent).data.lastActivityAt == request.time;
        }
        allow read: if signedIn() && exists(/databases/$(database)/documents/forums/$(postId));
        allow create: if signedIn() && validReply();
        allow update, delete: if false;
      }
    }

    match /users/{uid} {
      match /savedForums/{postId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && exists(/databases/$(database)/documents/forums/$(postId))
          && request.resource.data.keys().hasAll(['postId', 'savedAt'])
          && request.resource.data.keys().hasOnly(['postId', 'savedAt'])
          && request.resource.data.postId == postId && request.resource.data.savedAt == request.time;
      }
      // Provisioned only by a trusted project administrator, never by app clients.
      match /roles/verifier {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, create, update, delete: if false;
      }
      match /roles/moderator {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, create, update, delete: if false;
      }
      function profileValid() {
        let data = request.resource.data;
        return data.keys().hasAll(['uid', 'displayName', 'searchName', 'createdAt', 'updatedAt'])
          && data.keys().hasOnly(['uid', 'displayName', 'searchName', 'createdAt', 'updatedAt', 'major', 'bio', 'interests', 'avatar', 'meetupActivities', 'meetupOpen'])
          && data.uid == uid && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 40
          && data.displayName.matches('.*\\S.*') && data.searchName == data.displayName.lower()
          && data.get('major', '') is string && data.get('major', '').size() <= 80
          && data.get('bio', '') is string && data.get('bio', '').size() <= 280
          && data.get('avatar', 'initials') in ['initials', 'leaf', 'sun', 'planet', 'headphones', 'cat']
          && data.get('meetupOpen', false) is bool
          && validInterests(data.get('interests', []))
          && data.get('meetupActivities', []) is list && data.get('meetupActivities', []).size() <= 3
          && data.get('meetupActivities', []).hasOnly(['coffee', 'food', 'chat'])
          && data.updatedAt == request.time;
      }
      function validInterest(items, index) {
        return items.size() <= index || (items[index] is string && items[index].size() > 0
          && items[index].size() <= 24 && items[index].matches('.*\\S.*'));
      }
      function validInterests(items) {
        return items is list && items.size() <= 8 && items.toSet().size() == items.size()
          && validInterest(items, 0) && validInterest(items, 1) && validInterest(items, 2) && validInterest(items, 3)
          && validInterest(items, 4) && validInterest(items, 5) && validInterest(items, 6) && validInterest(items, 7);
      }
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && profileValid() && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid && profileValid() && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      match /friends/{friendId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && friendId != uid
          && exists(/databases/$(database)/documents/users/$(friendId))
          && request.resource.data.keys().hasOnly(['friendId', 'chatId', 'savedAt'])
          && request.resource.data.friendId == friendId && request.resource.data.savedAt == request.time
          && request.resource.data.chatId in ['dm:' + uid + ':' + friendId, 'dm:' + friendId + ':' + uid];
        allow update: if false;
      }
    }

    match /chats/{id} {
      function validAppearance(data) {
        return data is map && data.keys().hasAll(['kind', 'color'])
          && data.color in ['blue', 'violet', 'teal', 'rose', 'amber', 'slate']
          && ((data.kind == 'initials' && data.keys().hasOnly(['kind', 'color', 'text'])
              && data.text is string && data.text.matches('^[A-Z0-9]{1,3}$'))
            || (data.kind == 'icon' && data.keys().hasOnly(['kind', 'color', 'icon'])
              && data.icon in ['people-fill', 'chat-fill', 'book', 'mortarboard', 'controller', 'cup-hot', 'moon-stars', 'sun'])
            || (data.kind == 'image' && data.keys().hasOnly(['kind', 'color', 'image'])
              && data.image is string && data.image.size() <= 32768
              && data.image.matches('^data:image/jpeg;base64,/9j/[A-Za-z0-9+/]+={0,2}$')));
      }
      function validGroup() {
        let data = request.resource.data;
        return data.keys().hasAll(['name', 'visibility', 'salt', 'creatorId', 'createdAt', 'lastActivityAt', 'lastMessageId'])
          && data.keys().hasOnly(['name', 'visibility', 'salt', 'creatorId', 'createdAt', 'lastActivityAt', 'lastMessageId', 'appearance'])
          && (!('appearance' in data) || validAppearance(data.appearance))
          && data.name is string && data.name == id && data.name.size() > 0 && data.name.size() <= 60 && data.name.matches('.*\\S.*')
          && data.visibility in ['public', 'private']
          && data.creatorId == request.auth.uid
          && data.createdAt == request.time && data.lastActivityAt == request.time && data.lastMessageId == ''
          && ((data.visibility == 'public' && data.salt == '')
            || (data.visibility == 'private' && data.salt.matches('^[a-f0-9]{32}$')
              && getAfter(/databases/$(database)/documents/chats/$(id)/private/password).data.verifier.matches('^[a-f0-9]{64}$')));
      }
      function activityFromNewMessage() {
        let after = request.resource.data;
        let messagePath = /databases/$(database)/documents/chats/$(id)/messages/$(after.lastMessageId);
        return after.diff(resource.data).affectedKeys().hasOnly(['lastActivityAt', 'lastMessageId'])
          && after.lastActivityAt == request.time && after.lastMessageId is string && after.lastMessageId.size() > 0
          && !exists(messagePath)
          && getAfter(messagePath).data.senderId == request.auth.uid
          && getAfter(messagePath).data.createdAt == request.time;
      }
      function validDirect() {
        let data = request.resource.data;
        return data.keys().hasAll(['visibility', 'name', 'participantIds', 'createdAt', 'lastActivityAt', 'lastMessageId'])
          && data.keys().hasOnly(['visibility', 'name', 'participantIds', 'createdAt', 'lastActivityAt', 'lastMessageId'])
          && data.visibility == 'direct' && data.name == 'Direct message'
          && data.participantIds is list && data.participantIds.size() == 2
          && data.participantIds[0] is string && data.participantIds[1] is string
          && data.participantIds[0] != data.participantIds[1] && request.auth.uid in data.participantIds
          && id == 'dm:' + data.participantIds[0] + ':' + data.participantIds[1]
          && exists(/databases/$(database)/documents/users/$(data.participantIds[0]))
          && exists(/databases/$(database)/documents/users/$(data.participantIds[1]))
          && data.createdAt == request.time && data.lastActivityAt == request.time && data.lastMessageId == '';
      }
      function ownerDeletion() {
        let after = request.resource.data;
        let changed = after.diff(resource.data).affectedKeys();
        return signedIn() && id != 'Campus Chat' && !id.matches('^dm:.*')
          && resource.data.visibility in ['public', 'private'] && active(resource.data)
          && resource.data.creatorId == request.auth.uid
          && changed.hasAll(['deletedAt', 'deletedBy']) && changed.hasOnly(['deletedAt', 'deletedBy'])
          && after.deletedAt == request.time && after.deletedBy == request.auth.uid;
      }
      function ownerAppearance() {
        return signedIn() && id != 'Campus Chat' && !id.matches('^dm:.*')
          && resource.data.visibility in ['public', 'private'] && active(resource.data)
          && resource.data.creatorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appearance'])
          && validAppearance(request.resource.data.appearance);
      }
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/chats/$(id)) || visibleChat(resource.data));
      allow list: if signedIn() && visibleChat(resource.data);
      allow create: if signedIn() && id != 'Campus Chat' && (validDirect() || (!id.matches('^dm:.*') && validGroup()));
      allow update: if directParticipant(resource.data) && activityFromNewMessage();
      allow update: if id != 'Campus Chat' && resource.data.visibility in ['public', 'private']
        && member(id) && active(resource.data) && activityFromNewMessage();
      allow update: if ownerDeletion();
      allow update: if ownerAppearance();
      allow delete: if false;

      match /people/{uid} {
        allow read: if member(id) && active(group(id));
        allow create: if signedIn()
          && (request.auth.uid == uid || member(id))
          && active(getAfter(/databases/$(database)/documents/chats/$(id)).data)
          && existsAfter(/databases/$(database)/documents/chats/$(id)/members/$(uid))
          && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == uid;
        allow update, delete: if false;
      }
      match /members/{uid} {
        function joiningWithPasswordOrPublic() {
          let parent = getAfter(/databases/$(database)/documents/chats/$(id)).data;
          return uid == request.auth.uid && active(parent)
            && (parent.visibility == 'public' && request.resource.data.proof == ''
              || parent.visibility == 'private'
                && request.resource.data.proof == getAfter(/databases/$(database)/documents/chats/$(id)/private/password).data.verifier);
        }
        function acceptedByMember() {
          let decision = getAfter(/databases/$(database)/documents/chats/$(id)/requests/$(uid)).data;
          return member(id) && active(group(id)) && request.resource.data.proof == ''
            && decision.status == 'accepted' && decision.decidedBy == request.auth.uid && decision.decidedAt == request.time;
        }
        allow get: if signedIn() && uid == request.auth.uid && active(group(id));
        allow list, update, delete: if false;
        allow create: if signedIn()
          && request.resource.data.keys().hasAll(['joinedAt', 'proof'])
          && request.resource.data.keys().hasOnly(['joinedAt', 'proof'])
          && request.resource.data.joinedAt == request.time && request.resource.data.proof is string
          && getAfter(/databases/$(database)/documents/chats/$(id)/people/$(uid)).data.uid == uid
          && (joiningWithPasswordOrPublic() || acceptedByMember());
      }
      match /messages/{messageId} {
        allow read: if signedIn() && (id == 'Campus Chat' || directParticipant(group(id)) || member(id) && active(group(id)));
        // A removal and its immutable audit record must be committed together.
        allow delete: if canModerate(id)
          && !exists(/databases/$(database)/documents/chats/$(id)/moderation/$(messageId))
          && getAfter(/databases/$(database)/documents/chats/$(id)/moderation/$(messageId)).data.actorId == request.auth.uid
          && getAfter(/databases/$(database)/documents/chats/$(id)/moderation/$(messageId)).data.createdAt == request.time;
        allow create: if validMessage()
          && !exists(/databases/$(database)/documents/chats/$(id)/moderation/$(messageId))
          && (id == 'Campus Chat' || ((directParticipant(group(id)) || member(id) && active(group(id)))
          && getAfter(/databases/$(database)/documents/chats/$(id)).data.lastMessageId == messageId
          && getAfter(/databases/$(database)/documents/chats/$(id)).data.lastActivityAt == request.time));
        allow update: if false;
      }
      match /moderation/{messageId} {
        function validRemoval() {
          let data = request.resource.data;
          let message = /databases/$(database)/documents/chats/$(id)/messages/$(messageId);
          return data.keys().hasOnly(['action', 'messageId', 'actorId', 'createdAt', 'reason'])
            && (data.action == 'remove' || (data.action == 'clear' && id == 'Campus Chat'))
            && data.messageId == messageId && data.actorId == request.auth.uid
            && data.createdAt == request.time
            && data.reason is string && data.reason.size() > 0 && data.reason.size() <= 300
            && data.reason.matches('[\\s\\S]*\\S[\\s\\S]*')
            && exists(message) && !existsAfter(message);
        }
        allow read: if canModerate(id);
        allow create: if canModerate(id) && validRemoval();
        allow update, delete: if false;
      }
      match /requests/{uid} {
        function pendingRequest() {
          let data = request.resource.data;
          return request.auth.uid == uid && active(group(id)) && group(id).visibility == 'private'
            && data.keys().hasAll(['userId', 'name', 'status', 'createdAt', 'decidedAt', 'decidedBy'])
            && data.keys().hasOnly(['userId', 'name', 'status', 'createdAt', 'decidedAt', 'decidedBy'])
            && data.userId == uid && data.name is string && data.name.size() > 0 && data.name.size() <= 40
            && data.name.matches('.*\\S.*') && data.status == 'pending'
            && data.createdAt == request.time && data.decidedAt == null && data.decidedBy == '';
        }
        function validDecision() {
          let data = request.resource.data;
          return member(id) && active(group(id)) && resource.data.status == 'pending'
            && data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy'])
            && data.decidedBy == request.auth.uid && data.decidedAt == request.time
            && (data.status == 'denied' || (data.status == 'accepted'
              && getAfter(/databases/$(database)/documents/chats/$(id)/members/$(uid)).data.joinedAt == request.time));
        }
        allow read: if signedIn() && active(group(id)) && (uid == request.auth.uid || member(id));
        allow create: if signedIn() && pendingRequest();
        allow update: if signedIn() && (validDecision() || resource.data.status == 'denied' && pendingRequest());
        allow delete: if signedIn() && active(group(id)) && uid == request.auth.uid && resource.data.status == 'pending';
      }
    }
    match /chats/{id}/private/password {
      // Clients cannot download password verifiers, including the group creator.
      allow read, update, delete: if false;
      allow create: if signedIn() && !exists(/databases/$(database)/documents/chats/$(id))
        && getAfter(/databases/$(database)/documents/chats/$(id)).data.creatorId == request.auth.uid
        && getAfter(/databases/$(database)/documents/chats/$(id)).data.visibility == 'private'
        && request.resource.data.keys().hasOnly(['verifier'])
        && request.resource.data.verifier.matches('^[a-f0-9]{64}$');
    }
    match /chatPreferences/{uid}/pins/{id} {
      allow read: if signedIn() && uid == request.auth.uid;
      allow create, update: if signedIn() && uid == request.auth.uid
        && exists(/databases/$(database)/documents/chats/$(id))
        && request.resource.data.keys().hasOnly(['pinnedAt']) && request.resource.data.pinnedAt == request.time;
      allow delete: if signedIn() && uid == request.auth.uid;
    }
    // PULSE MANAGED RULES BEGIN
    match /pulse/{campusId} {
      function signedIn() { return request.auth != null; }
      function campusOpen() { return get(/databases/$(database)/documents/pulse/$(campusId)).data.enabled == true; }
      function ticketPath(uid) { return /databases/$(database)/documents/pulse/$(campusId)/availability/$(uid); }
      function planPath(id) { return /databases/$(database)/documents/pulse/$(campusId)/proposals/$(id); }
      function spotPath(id) { return /databases/$(database)/documents/pulse/$(campusId)/spots/$(id); }
      function member(p) {
        return signedIn() && request.auth.uid in p.participantIds && !(request.auth.uid in p.departedIds);
      }
      function groupOpen(p) {
        return p.status == 'confirmed' && p.participantIds.size() - p.departedIds.size() >= 2;
      }
      function chatOpen(id) {
        let p = get(planPath(id)).data;
        return member(p) && groupOpen(p) && request.time < p.chatClosesAt;
      }
      function released(a) {
        let p = get(planPath(a.proposalId)).data;
        return p.status == 'expired' || p.responses.get(a.uid, {}).get('decision', '') == 'decline'
          || (p.status == 'confirmed' && (!(a.uid in p.participantIds) || a.uid in p.departedIds
            || p.participantIds.size() - p.departedIds.size() < 2 || request.time >= p.endsAt));
      }
      function free(a) { return a.status in ['waiting', 'closed'] || (a.proposalId != null && released(a)); }
      function validTicket(a, uid) {
        return a.keys().hasOnly(['uid', 'displayName', 'requestId', 'version', 'activities', 'walks',
            'status', 'proposalId', 'createdAt', 'updatedAt', 'expiresAt'])
          && a.uid == uid && a.displayName is string && a.displayName.size() > 0 && a.displayName.size() <= 40
          && a.requestId is string && a.requestId.size() >= 8 && a.requestId.size() <= 128
          && a.version is string && a.version.size() >= 8 && a.version.size() <= 128
          && a.activities is list && a.activities.size() >= 1 && a.activities.size() <= 3
          && a.activities.toSet().size() == a.activities.size() && a.activities.hasOnly(['coffee', 'food', 'chat'])
          && a.walks is map && a.walks.size() > 0 && a.walks.size() <= 50
          && a.status == 'waiting' && a.proposalId == null
          && a.createdAt == request.time && a.updatedAt == request.time
          && a.expiresAt is timestamp && a.expiresAt >= request.time + duration.value(14, 'm')
          && a.expiresAt <= request.time + duration.value(121, 'm');
      }
      function reserve(a, next, uid) {
        let p = getAfter(planPath(next.proposalId)).data;
        return a.status == 'waiting' && a.proposalId == null && request.time < a.expiresAt
          && next.diff(a).affectedKeys().hasOnly(['status', 'proposalId', 'updatedAt'])
          && next.status == 'reserved' && next.updatedAt == request.time
          && p.status == 'pending' && p.createdAt == request.time && uid in p.candidateIds
          && a.version == p.availabilityVersions[uid] && a.displayName == p.participantNames[uid]
          && p.activity in a.activities && a.walks[p.spotId] is int && a.walks[p.spotId] >= 1 && a.walks[p.spotId] <= 20
          && p.walkingMinutes[uid] == a.walks[p.spotId]
          && p.startsAt >= p.responseDeadline + duration.value(a.walks[p.spotId] * 60 + 60, 's')
          && p.endsAt <= a.expiresAt - duration.value(5, 'm');
      }
      allow read: if signedIn();
      allow write: if false;
      match /spots/{spotId} {
        allow read: if signedIn();
        allow write: if false;
      }
      match /availability/{uid} {
        // Only names, interests, time windows and coarse walk estimates are discoverable.
        allow get: if signedIn() && (request.auth.uid == uid || resource.data.status == 'waiting'
          || request.auth.uid in get(planPath(resource.data.proposalId)).data.candidateIds);
        allow list: if signedIn() && resource.data.status == 'waiting'
          && request.query.limit != null && request.query.limit <= 100;
        allow create: if signedIn() && request.auth.uid == uid && campusOpen() && validTicket(request.resource.data, uid);
        allow update: if signedIn() && (
          (request.resource.data.status == 'reserved' && reserve(resource.data, request.resource.data, uid)) ||
          (request.auth.uid == uid && free(resource.data) && (
            (request.resource.data.status == 'waiting' && campusOpen() && validTicket(request.resource.data, uid)
              && request.resource.data.requestId != resource.data.requestId
              && request.resource.data.version != resource.data.version)
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
              && request.resource.data.status == 'closed' && request.resource.data.updatedAt == request.time)))
          );
        allow delete: if signedIn() && request.auth.uid == uid && free(resource.data);
      }
      match /proposals/{id} {
        function spotMatches(p) {
          let s = get(spotPath(p.spotId)).data;
          return s.enabled == true && s.verified == true && p.activity in s.activities
            && p.spot == { 'name': s.name, 'instruction': s.instruction, 'latitude': s.latitude, 'longitude': s.longitude };
        }
        function candidate(p, index) {
          let uid = p.candidateIds[index];
          let next = getAfter(ticketPath(uid)).data;
          return next.status == 'reserved' && next.proposalId == id;
        }
        function validProposal(p) {
          return p.keys().hasOnly(['candidateIds', 'participantNames', 'availabilityVersions', 'activity', 'spotId', 'spot',
              'walkingMinutes', 'walkingEstimate', 'minimumAcceptances', 'startsAt', 'endsAt', 'chatClosesAt',
              'responseDeadline', 'deleteAfter', 'status', 'responses', 'participantIds', 'departedIds', 'createdAt', 'updatedAt'])
            && p.candidateIds is list && p.candidateIds.size() >= 2 && p.candidateIds.size() <= 4
            && p.candidateIds.toSet().size() == p.candidateIds.size() && request.auth.uid in p.candidateIds
            && p.participantNames is map && p.participantNames.keys().hasOnly(p.candidateIds)
            && p.availabilityVersions is map && p.availabilityVersions.keys().hasOnly(p.candidateIds)
            && p.walkingMinutes is map && p.walkingMinutes.keys().hasOnly(p.candidateIds)
            && p.activity in ['coffee', 'food', 'chat'] && p.spotId is string && spotMatches(p)
            && p.status == 'pending' && p.responses == {} && p.participantIds == [] && p.departedIds == []
            && p.walkingEstimate == true && p.minimumAcceptances == 2
            && p.createdAt == request.time && p.updatedAt == request.time
            && p.responseDeadline is timestamp
            && p.responseDeadline >= request.time + duration.value(25, 's')
            && p.responseDeadline <= request.time + duration.value(65, 's')
            && p.startsAt is timestamp && p.endsAt is timestamp
            && p.endsAt - p.startsAt >= duration.value(10, 'm') && p.endsAt - p.startsAt <= duration.value(25, 'm')
            && p.chatClosesAt == p.endsAt + duration.value(10, 'm')
            && p.deleteAfter == p.endsAt + duration.value(24, 'h')
            && candidate(p, 0) && candidate(p, 1)
            && (p.candidateIds.size() < 3 || candidate(p, 2))
            && (p.candidateIds.size() < 4 || candidate(p, 3));
        }
        function ownResponse(p, next) {
          let uid = request.auth.uid;
          let r = next.responses.get(uid, {});
          return p.status == 'pending' && request.time < p.responseDeadline
            && next.diff(p).affectedKeys().hasOnly(['responses', 'updatedAt'])
            && next.responses.diff(p.responses).affectedKeys().hasOnly([uid])
            && p.responses.get(uid, {}).get('decision', '') != 'decline'
            && r.keys().hasOnly(['decision', 'respondedAt']) && r.decision in ['accept', 'decline']
            && r.respondedAt == request.time;
        }
        function accepts(p, i) {
          return p.candidateIds.size() > i && p.responses.get(p.candidateIds[i], {}).get('decision', '') == 'accept';
        }
        function accepted(p) {
          return (accepts(p, 0) ? [p.candidateIds[0]] : [])
            .concat(accepts(p, 1) ? [p.candidateIds[1]] : [])
            .concat(accepts(p, 2) ? [p.candidateIds[2]] : [])
            .concat(accepts(p, 3) ? [p.candidateIds[3]] : []);
        }
        function walk(p, i) { return accepts(p, i) ? p.walkingMinutes[p.candidateIds[i]] : 0; }
        function maximum(a, b) { return a > b ? a : b; }
        function longestWalk(p) { return maximum(maximum(walk(p, 0), walk(p, 1)), maximum(walk(p, 2), walk(p, 3))); }
        function settle(p, next) {
          let ids = accepted(p);
          let earliest = request.time + duration.value(longestWalk(p) * 60 + 60, 's');
          return p.status == 'pending' && (request.time >= p.responseDeadline || p.responses.keys().hasAll(p.candidateIds))
            && next.resolvedAt == request.time
            && (
              (next.status == 'confirmed' && ids.size() >= 2 && spotMatches(p)
                && next.diff(p).affectedKeys().hasOnly(['status', 'participantIds', 'startsAt', 'confirmedAt', 'resolvedAt', 'updatedAt'])
                && next.participantIds == ids && next.confirmedAt == request.time
                && next.startsAt >= p.startsAt && next.startsAt >= earliest - duration.value(5, 's')
                && next.endsAt - next.startsAt >= duration.value(10, 'm')
                && next.endsAt - next.startsAt <= duration.value(25, 'm'))
              || (next.status == 'expired'
                && next.diff(p).affectedKeys().hasOnly(['status', 'resolvedAt', 'updatedAt'])
                && (ids.size() < 2 || !spotMatches(p) || earliest + duration.value(10, 'm') >= p.endsAt - duration.value(3, 's')))
            );
        }
        function leave(p, next) {
          return p.status == 'confirmed' && request.auth.uid in p.participantIds && !(request.auth.uid in p.departedIds)
            && next.diff(p).affectedKeys().hasOnly(['departedIds', 'updatedAt'])
            && next.departedIds == p.departedIds.concat([request.auth.uid]);
        }
        allow read: if signedIn() && request.auth.uid in resource.data.candidateIds;
        allow create: if signedIn() && campusOpen() && validProposal(request.resource.data);
        allow update: if signedIn() && request.auth.uid in resource.data.candidateIds
          && request.resource.data.updatedAt == request.time
          && (ownResponse(resource.data, request.resource.data) || settle(resource.data, request.resource.data) || leave(resource.data, request.resource.data));
        // Admin cleanup removes children before the parent; clients cannot orphan messages.
        allow delete: if false;
        match /messages/{messageId} {
          allow read: if chatOpen(id);
          allow create: if chatOpen(id)
            && request.resource.data.keys().hasOnly(['senderId', 'text', 'createdAt'])
            && request.resource.data.senderId == request.auth.uid && request.resource.data.createdAt == request.time
            && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
            && request.resource.data.text.matches('[\\s\\S]*\\S[\\s\\S]*');
          allow update, delete: if false;
        }
        match /checkIns/{uid} {
          allow read: if chatOpen(id);
          // Arrival is self-reported. GPS checks run on-device and never upload fixes.
          allow create: if signedIn() && request.auth.uid == uid && chatOpen(id)
            && request.time < get(planPath(id)).data.endsAt
            && request.resource.data.keys().hasOnly(['uid', 'method', 'checkedInAt'])
            && request.resource.data.uid == uid && request.resource.data.method in ['manual', 'automatic']
            && request.resource.data.checkedInAt == request.time;
          allow update, delete: if false;
        }
      }
    }
    // PULSE MANAGED RULES END

  }
}
